{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000,
    },
    "buffer": 20000,
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "chrome-devtools-mcp@latest",
          "--isolated",
        ],
      }
    }
  },
}
